[global]
filename=/dev/nvme0n1
ioengine=libaio
direct=1
time_based
ramp_time=3s
runtime=30s
rw=read
iodepth=4
group_reporting=1

[background_1]
prioclass=1
prio=7
bs=1M
numjobs=1

